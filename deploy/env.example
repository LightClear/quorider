# 路障棋 Quorider —— 服务端环境变量示例
#
# 用法一：systemd
#   sudo cp deploy/env.example /etc/quorider.env
#   sudo vi /etc/quorider.env
#   然后在 deploy/quorider.service 里取消注释这一行：
#     EnvironmentFile=-/etc/quorider.env
#   sudo systemctl daemon-reload && sudo systemctl restart quorider
#
# 用法二：docker compose
#   cp deploy/env.example .env
#   docker compose up -d
#
# 用法三：直接跑
#   PORT=8080 node server.js

# 监听端口，默认 3000
PORT=3000

# 监听地址，默认 0.0.0.0
#   直接用 IP 访问  -> 0.0.0.0
#   nginx 反向代理   -> 127.0.0.1（只对本地开放，更安全）
HOST=0.0.0.0

# 运行模式标记（仅用于日志/约定，应用本身不区分）
NODE_ENV=production
